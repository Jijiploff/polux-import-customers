# ============ SQL Server ============
MSSQL_SA_PASSWORD=CAMBIA-ESTA-PASSWORD-COMPLEJA-2025!
DB_HOST=db
DB_PORT=1433
DB_NAME=PoluxImportDB
DB_USER=sa
DB_PASSWORD=CAMBIA-ESTA-PASSWORD-COMPLEJA-2025!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=true

# ============ Aplicación ============
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://customers.poluximport.pe"]
JWT_SECRET_KEY=GENERA-UN-SECRETO-LARGO-Y-UNICO-DE-AL-MENOS-64-CARACTERES-ALEATORIOS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240

# ============ Scheduler (worker) ============
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_RUN_ON_STARTUP=false

# ============ WhatsApp (llenar con credenciales reales de Meta) ============
WHATSAPP_ENABLED=true
WHATSAPP_DRY_RUN=false
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=GENERA-UN-TOKEN-ALEATORIO
WHATSAPP_APP_SECRET=GENERA-EN-META-APP-SECRET
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_API_TIMEOUT_SECONDS=15
WHATSAPP_MAX_RETRIES=5
WHATSAPP_BACKOFF_BASE_SECONDS=30

# ============ Correo ============
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_...
EMAIL_FROM=no-reply@poluximport.pe
EMAIL_FROM_NAME=Polux Import

# ============ Outbox ============
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_SECONDS=60
OUTBOX_BATCH_SIZE=50

# ============ Telegram ============
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdef-GHIjklMNOpqrSTUvwxYZ12345678
TELEGRAM_WEBHOOK_SECRET=GENERA-UN-SECRETO-ALEATORIO-LARGO
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_API_TIMEOUT_SECONDS=15

# ============ LLM (si se usa real) ============
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=400

# ============ Frontend (build) ============
VITE_API_BASE_URL=/api/v1