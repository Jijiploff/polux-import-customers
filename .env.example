# --- SQL Server ---
MSSQL_SA_PASSWORD=Polux#Strong!Pwd2025
DB_HOST=db
DB_PORT=1433
DB_NAME=PoluxImportDB
DB_USER=sa
DB_PASSWORD=Polux#Strong!Pwd2025
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=true

# --- Aplicación ---
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Integraciones (se completan en Fases 4-5) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# Añadir a .env.example de Fase 0:
JWT_SECRET_KEY=cambia-esto-en-produccion-por-un-secreto-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Scheduler (motor de reglas) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_RUN_ON_STARTUP=false

# --- Agente IA ---
LLM_PROVIDER=mock           # mock | openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=400

# --- WhatsApp Business Cloud API ---
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=polux-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_API_TIMEOUT_SECONDS=15
WHATSAPP_MAX_RETRIES=5
WHATSAPP_BACKOFF_BASE_SECONDS=30

# --- Correo de respaldo ---
EMAIL_ENABLED=false
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=no-reply@poluximport.pe
EMAIL_FROM_NAME=Polux Import
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Outbox worker ---
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_SECONDS=60
OUTBOX_BATCH_SIZE=50